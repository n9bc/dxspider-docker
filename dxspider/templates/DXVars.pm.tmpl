# DXVars.pm — DXSpider node configuration
# Generated by entrypoint.sh from DXVars.pm.tmpl.
# This file is written on first run (or when OVERWRITE_CONFIG=yes).
# Operator edits survive container restarts because /spider/local is a
# named volume; the file is only replaced when absent or OVERWRITE_CONFIG=yes.
#
# Token substitution map (entrypoint.sh sed replacements):
#   __NODE_CALL__   <- NODE_CALL         (required, e.g. N0CALL-2)
#   __SYSOP_CALL__  <- SYSOP_CALL        (required, e.g. N0CALL)
#   __SYSOP_NAME__  <- SYSOP_NAME        (required, e.g. "John Smith")
#   __LOCATOR__     <- LOCATOR           (required, e.g. FN31pr)
#   __QTH__         <- NODE_QTH          (optional, default "Unknown QTH")
#   __EMAIL__       <- SYSOP_EMAIL       (optional, default "sysop@example.com")

package DXVars;

use strict;

# ---------------------------------------------------------------------------
# Identity — all tokens replaced by entrypoint.sh
# ---------------------------------------------------------------------------

# Full callsign of this cluster node (including SSID, e.g. N0CALL-2).
our $mycall    = "__NODE_CALL__";

# Sysop's personal callsign (no SSID).
our $myalias   = "__SYSOP_CALL__";

# Sysop's name (used in welcome banners).
our $myname    = "__SYSOP_NAME__";

# Grid-square locator of the node site.
our $mylocator = "__LOCATOR__";

# QTH description (city, state/country).
our $myqth     = "__QTH__";

# Contact e-mail shown in /show/dx output.
our $myemail   = "__EMAIL__";

# ---------------------------------------------------------------------------
# Paths — relative to Spider root; leave as-is unless you know why.
# ---------------------------------------------------------------------------
our $data      = "/spider/local_data";
our $cmd       = "/spider/cmd";
our $perl      = "/spider/perl";
our $spots     = "/spider/local_data/spots";
our $msg       = "/spider/local_data/msg";
our $log       = "/spider/local_data/log";

# ---------------------------------------------------------------------------
# Cluster behaviour defaults
# ---------------------------------------------------------------------------

# Maximum number of simultaneously connected users.
our $maxconnect = 10;

# Spots announced to local users (0 = all, positive N = last N seconds).
our $annoucedx  = 0;

# Log spot data for showdx (days to keep).
our $keepalive  = 2;

# Timezone offset from UTC in hours (use 0 for UTC; DXSpider prefers UTC).
our $UTC = 0;

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
our $debugpath = "/spider/local_data/debug";

# ---------------------------------------------------------------------------
# Phase 2 — inter-cluster peering (BPQ/AR-Cluster/DX Spider nodes)
# Uncomment and populate when you are ready to peer with upstream nodes.
# These settings are intentionally inactive in Phase 1.
# ---------------------------------------------------------------------------
#
# Example static BPQ peer (replace with your upstream node details):
# our @bpq_nodes = ();      # e.g. qw(GB7TLH GB7DJK)
#
# Example AR-Cluster / DX Spider connect block goes in /spider/local/connect/
# (one file per peer, not in DXVars.pm).  See /spider/cmd/connect.hlp.
#
# Phase 2 env vars (document in compose):
#   UPSTREAM_NODE_CALL   — callsign of upstream node to connect to
#   UPSTREAM_NODE_HOST   — hostname/IP
#   UPSTREAM_NODE_PORT   — port (default 7300)
#
# ---------------------------------------------------------------------------

1;   # Perl module — required true return value
