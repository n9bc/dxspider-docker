# DXVars.pm — DXSpider node configuration
# Generated by entrypoint.sh from DXVars.pm.tmpl.
# This file is written on first run (or when OVERWRITE_CONFIG=yes).
# Operator edits survive container restarts because /spider/local is a
# named volume; the file is only replaced when absent or OVERWRITE_CONFIG=yes.
#
# Token substitution map (entrypoint.sh sed replacements):
#   __NODE_CALL__   <- NODE_CALL         (required, e.g. N0CALL-2)
#   __SYSOP_CALL__  <- SYSOP_CALL        (required, e.g. N0CALL)
#   __SYSOP_NAME__  <- SYSOP_NAME        (required, e.g. "John Smith")
#   __LOCATOR__     <- LOCATOR           (required, e.g. FN31pr)
#   __QTH__         <- NODE_QTH          (optional, default "Unknown QTH")
#   __EMAIL__       <- SYSOP_EMAIL       (optional, default "sysop@example.com")
#
# IMPORTANT: DXSpider loads this file with `use DXVars;` and expects the
# configuration variables to live in the `main::` package as plain globals
# (this matches the upstream DXVars.pm.issue sample).  Do NOT add
# `package DXVars;`, `use strict;`, or `our` — that hides the variables in
# the wrong namespace and every DXSpider script reads them as empty.
#
# Substituted string values are SINGLE-quoted on purpose: there is no
# `use strict` here, so a double-quoted "n9bc@arrl.net" would interpolate
# @arrl as an (empty) array and silently corrupt the value.

package main;

# ---------------------------------------------------------------------------
# Identity — all tokens replaced by entrypoint.sh.  Use CAPITAL LETTERS for
# callsigns (DXSpider upper-cases them anyway and warns if it has to).
# ---------------------------------------------------------------------------

# Full callsign of this cluster node (including SSID, e.g. N0CALL-2).
$mycall = '__NODE_CALL__';

# Sysop's personal callsign (no SSID).
$myalias = '__SYSOP_CALL__';

# Sysop's name (used in welcome banners).
$myname = '__SYSOP_NAME__';

# Grid-square locator of the node site.
$mylocator = '__LOCATOR__';

# QTH description (city, state/country).
$myqth = '__QTH__';

# Contact e-mail shown in /show/dx output.
$myemail = '__EMAIL__';

# Latitude  (+)ve = North, (-)ve = South — decimal degrees.
# Longitude (+)ve = East,  (-)ve = West  — decimal degrees.
# Left at 0.0; DXSpider derives position from $mylocator when these are unset.
$mylatitude = +0.0;
$mylongitude = +0.0;

# ---------------------------------------------------------------------------
# Country codes this node is located in.  Empty = derive from $mycall, which
# suits almost every sysop.  Example for Spain: qw(EA EA8 EA9 EA0)
# ---------------------------------------------------------------------------
@my_cc = qw();

# ---------------------------------------------------------------------------
# Debug categories written to the debug log.
# ---------------------------------------------------------------------------
@debug = qw(chan state msg cron connect progress nologchan);

# Emit XML? (legacy feature; keep 0 unless you know you need it.)
$do_xml = 0;

# Contest announcement host (upstream default; rarely changed).
$Internet::contest_host = "contest.dxtron.com";

1;   # Perl module — required true return value
